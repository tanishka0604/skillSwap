<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SkillSwap</display-name>

    <!--
      Our servlets already declare their own URL with @WebServlet(...)
      annotations (see RegisterServlet, LoginServlet, LogoutServlet,
      DashboardServlet), so we don't need <servlet> / <servlet-mapping>
      entries here for them — Tomcat 8.5+ reads the annotations directly.
      This file is still required as the app's main descriptor, and is
      where we set the welcome page and session timeout.
    -->

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Minutes of inactivity before a session is automatically invalidated -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
